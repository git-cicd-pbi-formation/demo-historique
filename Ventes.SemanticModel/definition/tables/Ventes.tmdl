table Ventes

	measure 'CA HT' =
			CALCULATE (
			    SUM ( Ventes[MontantHT] ),
			    Ventes[Statut] <> "Annulée"
			)
		formatString: #,0 €

	measure 'Nb commandes' = DISTINCTCOUNT ( Ventes[NumCommande] )
		formatString: #,0

	measure 'Panier moyen' = DIVIDE ( [CA HT], [Nb commandes] )
		formatString: #,0.00 €

	measure 'CA HT N-1' = CALCULATE ( [CA HT], SAMEPERIODLASTYEAR ( Calendrier[Date] ) )
		formatString: #,0 €

	column NumCommande
		dataType: string
		sourceColumn: NumCommande

	column MontantHT
		dataType: decimal
		sourceColumn: MontantHT

	column Statut
		dataType: string
		sourceColumn: Statut
