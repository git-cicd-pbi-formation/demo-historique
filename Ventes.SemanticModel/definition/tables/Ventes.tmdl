table Ventes

	measure 'CA HT' = SUM ( Ventes[MontantHT] )
		formatString: #,0 €

	measure 'Nb commandes' = DISTINCTCOUNT ( Ventes[NumCommande] )
		formatString: #,0

	measure 'Panier moyen' = DIVIDE ( [CA HT], [Nb commandes] )
		formatString: #,0.00 €

	column NumCommande
		dataType: string
		sourceColumn: NumCommande

	column MontantHT
		dataType: decimal
		sourceColumn: MontantHT

	column Statut
		dataType: string
		sourceColumn: Statut
